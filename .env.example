# required
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://gateway.example.com              # public URL of the gateway
AUTH_DATABASE_URL=postgresql://user:pass@localhost:5432/nagomi_auth
NAGOMI_CORE_URL=http://localhost:55555
TRUSTED_ORIGINS=http://localhost:55554,https://example.com  # comma-separated

# optional
COOKIE_DOMAIN=.example.com                               # for cross-subdomain cookies
HOSTNAME=127.0.0.1
PORT=55550
LOG_LEVEL=info                                           # debug, info, warn, error
LOG_FORMAT=text                                          # text or json
