BETTER_AUTH_SECRET=your-auth-secret
BETTER_AUTH_URL=https://gateway.example.com

NAGOMI_CORE_URL=http://localhost:55555
AUTH_DATABASE_URL=postgresql://nagomi:postgres_password@localhost:5432/auth

TRUSTED_ORIGINS=http://localhost:55554,https://your-frontend.example.com
COOKIE_DOMAIN=.example.com

HOSTNAME=127.0.0.1
PORT=55550

LOG_LEVEL=info   # debug, info, warn, error (default: info)
LOG_FORMAT=text  # text or json — json also writes to nagomi-gateway.log (default: text)
